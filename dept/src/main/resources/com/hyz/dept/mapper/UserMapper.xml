<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hyz.dept.mapper.UserMapper">

    <!-- 结果映射：数据库列 <-> 实体属性 -->
    <resultMap id="UserResultMap" type="com.hyz.dept.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
    </resultMap>

    <!-- 公共列清单（注意 user 是 MySQL 关键字，需用反引号） -->
    <sql id="Base_Column_List">
        id, username, password
    </sql>

    <!-- 查询所有用户 -->
    <select id="selectAll" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `t_user`
        ORDER BY id
    </select>

    <!-- 根据主键查询 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `t_user`
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询（登录校验可用） -->
    <select id="selectByUsername" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `t_user`
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 新增用户（主键自增写回实体） -->
    <insert id="insert" parameterType="com.hyz.dept.entity.User"
            keyProperty="id" keyColumn="id" useGeneratedKeys="true">
        INSERT INTO `t_user` (username, password)
        VALUES (#{username}, #{password})
    </insert>

    <!-- 根据主键修改（仅更新传入的非空字段） -->
    <update id="updateById" parameterType="com.hyz.dept.entity.User">
        UPDATE `t_user`
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM `t_user`
        WHERE id = #{id}
    </delete>

</mapper>